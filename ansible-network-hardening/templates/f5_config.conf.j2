# F5 Load Balancer - Hardened Configuration (generated by Ansible)
# Reflects secure settings from group_vars - do not edit manually for baseline

# --- TLS / SSL ---
ssl-min-version {{ min_tls_version }}
ssl-max-version "1.3"
ssl-ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384"

# --- Allowed listener ports (gold standard only) ---
# HTTP: {{ gold_standard_ports[0] }}, HTTPS: {{ gold_standard_ports[1] }}
{% for port in gold_standard_ports %}
listen-port {{ port }}
{% endfor %}

# --- Disabled legacy/insecure services ---
{% for svc in legacy_services_to_disable %}
# {{ svc }} disabled by security policy
{% endfor %}

# --- General hardening ---
security-log-level warning
remote-access restricted
